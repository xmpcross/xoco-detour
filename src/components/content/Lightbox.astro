---
import Icon from "@/components/ui/Icon.astro";

/**
 * The enlarged view for article images. One dialog per page, driven by any
 * element carrying `data-lightbox` — see `Figure.astro` and `Gallery.astro`.
 *
 * A native `<dialog>` does the work that is easy to get wrong by hand: it
 * traps focus, closes on Escape, returns focus to the trigger, and marks the
 * rest of the page inert. The script only has to pick the image and step
 * through the group.
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Image viewer">
  <div class="lightbox__inner">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close image">
      <Icon name="close" size={20} />
    </button>

    <button
      class="lightbox__nav lightbox__nav--prev"
      type="button"
      data-lightbox-prev
      aria-label="Previous image"
    >
      <Icon name="arrow-left" size={20} />
    </button>

    <figure class="lightbox__figure">
      <img data-lightbox-img alt="" />
      <figcaption class="lightbox__caption">
        <span class="lightbox__text" data-lightbox-text></span>
        <span class="lightbox__count label" data-lightbox-count></span>
      </figcaption>
    </figure>

    <button
      class="lightbox__nav lightbox__nav--next"
      type="button"
      data-lightbox-next
      aria-label="Next image"
    >
      <Icon name="arrow-right" size={20} />
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const text = dialog.querySelector<HTMLElement>("[data-lightbox-text]")!;
    const count = dialog.querySelector<HTMLElement>("[data-lightbox-count]")!;
    const prev = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]")!;
    const next = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]")!;

    let group: HTMLElement[] = [];
    let index = 0;

    const show = (i: number) => {
      /* Wraps in both directions, so the arrows never dead-end mid-set. */
      index = (i + group.length) % group.length;
      const el = group[index];
      img.src = el.dataset.lightboxSrc ?? "";
      img.alt = el.dataset.lightboxAlt ?? "";

      const caption = el.dataset.lightboxCaption ?? "";
      const credit = el.dataset.lightboxCredit ?? "";
      text.textContent = [caption, credit].filter(Boolean).join(" — ");
      count.textContent = group.length > 1 ? `${index + 1} / ${group.length}` : "";

      const many = group.length > 1;
      prev.hidden = !many;
      next.hidden = !many;
    };

    document.addEventListener("click", (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>("[data-lightbox]");
      if (!trigger) return;
      event.preventDefault();

      const name = trigger.dataset.lightboxGroup ?? "";
      group = [...document.querySelectorAll<HTMLElement>("[data-lightbox]")].filter(
        (el) => (el.dataset.lightboxGroup ?? "") === name,
      );
      show(group.indexOf(trigger));
      dialog.showModal();
    });

    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    /* Click outside the figure closes. The dialog fills the viewport, so the
       backdrop test is against the inner block rather than the dialog itself. */
    dialog.addEventListener("click", (event) => {
      const inner = dialog.querySelector(".lightbox__figure");
      if (inner && !inner.contains(event.target as Node)) {
        const onControl = (event.target as HTMLElement | null)?.closest("button");
        if (!onControl) dialog.close();
      }
    });

    /* Swipe, for the widths where the arrows are hidden. The picture follows
       the finger and snaps back when the throw was too short to count. */
    const figure = dialog.querySelector<HTMLElement>(".lightbox__figure")!;
    let startX = 0;
    let startY = 0;
    let dx = 0;
    let dragging = false;

    const endDrag = (commit: boolean) => {
      if (!dragging) return;
      dragging = false;

      const step = commit && Math.abs(dx) > Math.max(40, window.innerWidth * 0.12);
      /* A committed swipe replaces the image, so sliding the old one home
         first would only animate a frame the reader has already left. */
      img.style.transition = step ? "none" : "";
      img.style.translate = "";
      img.style.opacity = "";
      if (step) {
        show(dx < 0 ? index + 1 : index - 1);
        requestAnimationFrame(() => {
          img.style.transition = "";
        });
      }
      dx = 0;
    };

    figure.addEventListener(
      "touchstart",
      (event) => {
        if (group.length < 2 || event.touches.length !== 1) return;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        dx = 0;
        dragging = true;
        img.style.transition = "none";
      },
      { passive: true },
    );

    figure.addEventListener(
      "touchmove",
      (event) => {
        if (!dragging) return;
        const x = event.touches[0].clientX - startX;
        const y = event.touches[0].clientY - startY;
        /* A drag that is mostly vertical is a scroll or a dismiss, not a step
           through the set — hand it back rather than fighting for it. */
        if (Math.abs(y) > Math.abs(x)) {
          endDrag(false);
          return;
        }
        dx = x;
        img.style.translate = `${dx}px 0`;
        img.style.opacity = `${1 - Math.min(Math.abs(dx) / 500, 0.45)}`;
      },
      { passive: true },
    );

    figure.addEventListener("touchend", () => endDrag(true));
    figure.addEventListener("touchcancel", () => endDrag(false));

    /* Drop the source on close so a large image is not held in memory. */
    dialog.addEventListener("close", () => {
      endDrag(false);
      img.removeAttribute("src");
    });
  }
</script>
