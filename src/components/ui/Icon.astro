---
/**
 * Small stroked UI icons on a 24x24 grid. Editorial chrome only — social and
 * brand marks still come from LocalIcon.
 */
export type IconName =
  | "arrow-right"
  | "arrow-left"
  | "arrow-up-right"
  | "chevron-down"
  | "search"
  | "bookmark"
  | "menu"
  | "close"
  | "calendar"
  | "clock"
  | "map-pin"
  | "sliders";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-right" && <path d="M5 12h13m-6-6 6 6-6 6" />}
  {name === "arrow-left" && <path d="M19 12H6m6-6-6 6 6 6" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7m-7 0h7v7" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {
    name === "calendar" && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M8 3v4m8-4v4M3 10h18" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5.2l3.2 1.9" />
      </>
    )
  }
  {
    /* Where it was filed from. */
    name === "map-pin" && (
      <>
        <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
  {
    name === "sliders" && (
      <>
        <path d="M4 7h9M17 7h3M4 12h3M11 12h9M4 17h11M19 17h1" />
        <circle cx="15" cy="7" r="2" />
        <circle cx="9" cy="12" r="2" />
        <circle cx="17" cy="17" r="2" />
      </>
    )
  }
  {name === "search" && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16.5 16.5 4 4" />
      </>
    )}
  {name === "bookmark" && <path d="M6.5 4.5h11V21L12 16.6 6.5 21Z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
</svg>
