---
import { Image } from "astro:assets";
import PostHeroHead from "@/components/PostHeroHead.astro";
import { storyLayoutFor, type Post } from "@/lib/posts";

/**
 * The opening of an article. Five treatments share one title block, so a
 * publication can change how a story arrives without the byline, the tag, or
 * the read time moving to a different place each time:
 *
 * - `standard`   type first, then the cover a step wider than the column
 * - `split`      the cover taking one half of the screen, the type the other
 * - `banner`     an edge-to-edge strip, the type on a card overlapping it
 * - `parallax`   type first, then a tall strip the photograph moves inside
 * - `cover`      the photograph carries the headline, at a fixed height
 * - `immersive`  the type centred on a full-height cover, header in overlay
 *
 * A post with `cover.showInPost: false` falls back to `standard` and simply
 * renders no picture — see `storyLayoutFor`.
 */
interface Props {
  post: Post;
}

const { post } = Astro.props;
const data = post.data;
const layout = storyLayoutFor(post);
const showCover = data.cover.showInPost ?? true;

/** Requested widths for the three openings that run to 100vw. The top step is
    the width the demo covers ship at — Astro will not upscale past it. */
const bleedWidths = [640, 960, 1280, 1600, 2000, 2400];
---

{
  /* Type first, photograph second. The quiet default: nothing is cropped and
     the headline is the first thing read. The cover steps out of the reading
     column to the width every picture in the article below it gets. */
  layout === "standard" && (
    <header class="posthero">
      <div class="container-reading">
        <PostHeroHead post={post} />
      </div>

      {showCover && (
        <figure class="posthero__figure">
          <div class="media media--photo">
            <Image
              src={data.cover.src}
              alt={data.cover.alt}
              widths={[640, 960, 1280, 1600, 2000]}
              sizes="(min-width: 58rem) 864px, 92vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption class="txt-xs txt-dim posthero__credit">
            Photo credit:{" "}
            <a class="underline-hover" href={data.cover.creditUrl} rel="noreferrer">
              {data.cover.creditName}
            </a>
          </figcaption>
        </figure>
      )}
    </header>
  )
}

{
  /*
   * The cover takes one half of the screen and the type the other, on a ground
   * of its own. `cover.side` decides which half the picture gets; on a phone
   * the two stack, picture first, which is the order every other opening uses.
   */
  layout === "split" && (
    <header class:list={["posthero", "posthero-split", `posthero-split--${data.cover.side}`]}>
      <div class="posthero-split__media">
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 64rem) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="posthero-split__body">
        <div class="posthero-split__stage">
          <PostHeroHead post={post}>
            <p class="txt-xs txt-dim posthero__credit">
              Photo credit:{" "}
              <a class="underline-hover" href={data.cover.creditUrl} rel="noreferrer">
                {data.cover.creditName}
              </a>
            </p>
          </PostHeroHead>
        </div>
      </div>
    </header>
  )
}

{
  /* An edge-to-edge strip, with the title block on a card riding up onto the
     foot of it. The photograph opens the page without taking it over, and the
     credit joins the block as its last line rather than trailing the byline
     several lines further down. */
  layout === "banner" && (
    <header class="posthero posthero--banner">
      <div class="posthero-banner__media">
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={bleedWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="container posthero-banner__lift">
        <div class="posthero-banner__card">
          <PostHeroHead post={post}>
            <p class="txt-xs txt-dim posthero__credit">
              Photo credit:{" "}
              <a class="underline-hover" href={data.cover.creditUrl} rel="noreferrer">
                {data.cover.creditName}
              </a>
            </p>
          </PostHeroHead>
        </div>
      </div>
    </header>
  )
}

{
  /*
   * Type first, then a tall strip the photograph moves inside as the page
   * scrolls. The title block is the `standard` one, unchanged — the picture is
   * the only thing doing anything different, which is the point: a parallax
   * opening is a landscape you drive past, not a new way to set a headline.
   *
   * The movement is a scroll-driven CSS animation, so there is no listener and
   * nothing runs on the main thread. Where view timelines are missing the strip
   * is simply a tall, well-cropped picture, and `prefers-reduced-motion` gets
   * the same — see `.posthero-parallax` in the stylesheet.
   */
  layout === "parallax" && (
    <header class="posthero">
      <div class="container-reading">
        <PostHeroHead post={post} />
      </div>

      <figure class="posthero-parallax">
        <div class="posthero-parallax__frame">
          <div class="posthero-parallax__media">
            <Image
              src={data.cover.src}
              alt={data.cover.alt}
              widths={bleedWidths}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
        <figcaption class="container txt-xs txt-dim posthero__credit">
          Photo credit:{" "}
          <a class="underline-hover" href={data.cover.creditUrl} rel="noreferrer">
            {data.cover.creditName}
          </a>
        </figcaption>
      </figure>
    </header>
  )
}

{
  /* The photograph carries the headline, at a height that still leaves the top
     of the page to the header. Type goes white in both colour themes, because
     it sits on the picture rather than on the page. */
  layout === "cover" && (
    <header class="posthero posthero-cover">
      <div class="posthero-cover__media">
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={bleedWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="posthero-cover__scrim" aria-hidden="true" />

      {/* The reading measure, not the wide track: the headline then starts on
          the same left edge as the article body underneath it. */}
      <div class="container-reading posthero-cover__inner">
        <PostHeroHead post={post} onImage>
          <p class="txt-xs posthero__credit posthero__credit--onImage">
            Photo credit:{" "}
            <a class="underline-hover" href={data.cover.creditUrl} rel="noreferrer">
              {data.cover.creditName}
            </a>
          </p>
        </PostHeroHead>
      </div>
    </header>
  )
}

{
  /*
   * The photograph fills the viewport from the first pixel and the header rides
   * on it — the article page renders the bar in overlay mode for this one. The
   * title block is centred, the only place in the theme where type is not
   * aligned to the left edge of the track: nothing else is on screen to align
   * to.
   */
  layout === "immersive" && (
    <header class="posthero posthero-immersive">
      <div class="posthero-immersive__media">
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={bleedWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="posthero-immersive__scrim" aria-hidden="true" />

      <div class="container posthero-immersive__inner">
        <div class="posthero-immersive__stage">
          <PostHeroHead post={post} onImage display center>
            <p class="txt-xs posthero__credit posthero__credit--onImage">
              Photo credit:{" "}
              <a class="underline-hover" href={data.cover.creditUrl} rel="noreferrer">
                {data.cover.creditName}
              </a>
            </p>
          </PostHeroHead>
        </div>
      </div>
    </header>
  )
}
